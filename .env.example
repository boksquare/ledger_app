# Copy to .env next to docker-compose.yml and fill in. NEVER commit the real .env.
# Statement import is optional; only fill in the block for whichever
# LEDGER_AI_PROVIDER you're using. See README's Configuration section for details.

LEDGER_AI_PROVIDER=claude_code

# --- claude_code (default) — subscription-based, no API key. Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
LEDGER_AI_MODEL=sonnet
LEDGER_AI_EFFORT=low

# --- nvidia_nim
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# LEDGER_AI_MODEL=meta/llama-3.1-70b-instruct

# --- gemini
# GEMINI_API_KEY=
# LEDGER_AI_MODEL=gemini-2.0-flash

# --- openai_compatible (OpenAI itself, or any compatible provider/local server)
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# LEDGER_AI_MODEL=gpt-4o-mini
